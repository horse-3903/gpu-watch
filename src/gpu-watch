#!/usr/bin/env bash
set -euo pipefail

# ---------------------------------------------------------------------------
# gpu-watch — wrap any training command with live logs, GPU stats, and ntfy
# ---------------------------------------------------------------------------

SCRIPT_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
METRICS_SCRIPT="${SCRIPT_DIR}/gpu_watch_metrics.py"
if [[ ! -f "$METRICS_SCRIPT" ]]; then
    METRICS_SCRIPT="/usr/local/bin/gpu_watch_metrics.py"
fi

# ---------------------------------------------------------------------------
# Defaults
# ---------------------------------------------------------------------------
TOPIC=""
RUN_NAME=""
INTERVAL=10
METRIC_INTERVAL=5
GPU_INTERVAL=60
LOG_DIR="logs"
METRICS_DIR="."
METRIC_KEYS=""
METRIC_TOP_K=8
GPU_ENABLED=true
METRICS_ENABLED=true
# shellcheck disable=SC2016  # intentional: $RUNPOD_POD_ID expands at run time
POST_CMD='runpodctl stop pod $RUNPOD_POD_ID'
POST_CMD_ENABLED=true
POST_CMD_DELAY=1800   # seconds to wait after failure before running anyway (30 min)
CMD=()
PHASES_FILE=""
PHASE_CMDS=()   # per-phase command strings (bash -c compatible)
PHASE_NAMES=()  # per-phase display names

FINAL_SENT=0
GPU_LOOP_PID=""
STATUS_LOOP_PID=""
TEE_PID=""
FIFO=""
CHILD_PID=""
START_TIME=""
RUN_DIR=""
TRAIN_LOG=""
GPU_LOG=""
METRICS_LOG=""

# ---------------------------------------------------------------------------
# Usage
# ---------------------------------------------------------------------------
usage() {
    cat <<EOF
Usage: gpu-watch --topic TOPIC [OPTIONS] -- COMMAND [ARGS...]
       gpu-watch --topic TOPIC [OPTIONS] --phase NAME CMD [--phase NAME CMD ...]
       gpu-watch --topic TOPIC [OPTIONS] --phases FILE

Required:
  --topic TOPIC               ntfy.sh topic name

Optional:
  --name NAME                 Run name (default: run-YYYYMMDD-HHMMSS)
  --interval MINUTES          Periodic ntfy interval in minutes (default: 10)
  --metric-interval MINUTES   Metric extraction interval in minutes (default: 5)
  --gpu-interval SECONDS      GPU poll interval in seconds (default: 60)
  --log-dir DIR               Log base directory (default: logs)
  --metrics-dir DIR           Directory to search for metric files (default: .)
  --metric-keys KEYS          Comma-separated metric keys to prefer
  --metric-top-k N            Max metrics to show (default: 8)
  --no-gpu                    Disable GPU monitoring
  --no-metrics                Disable metric extraction
  --post-cmd CMD              Command to run after all training finishes
                              (default: runpodctl stop pod \$RUNPOD_POD_ID)
  --no-post-cmd               Disable the post-training command
  --help                      Show this help

Multi-phase training:
  --phase NAME CMD            Add a named training phase. CMD is a shell string
                              passed to bash -c. Phases run sequentially; the
                              first failure stops remaining phases. Repeat to
                              define multiple phases.

  --phases FILE               Load phases from a file. Each non-empty,
                              non-comment line is a command. Precede a command
                              with a [name] header to set its display name.

  Each phase gets its own log file (train_phaseN_NAME.log) plus per-phase
  ntfy notifications on start, success, and failure. A combined train.log
  aggregates all output.

Post-command behaviour:
  On success  — runs immediately after all phases finish
  On failure  — waits 30 minutes so you can inspect the error,
                then runs anyway; type 'run' + Enter to run early or
                type 'cancel' + Enter to skip it entirely

Examples:
  # Single command (existing behaviour)
  gpu-watch --topic my-topic -- python train.py

  # Multiple phases (inline)
  gpu-watch --topic my-topic --name seq-run \\
    --phase rfdetr "python train/train_rfdetr.py --config config/rfdetr.yaml" \\
    --phase rtdetr "python train/train_rtdetr.py --config config/rtdetr.yaml" \\
    --phase yolo   "python train/train_yolo.py   --config config/yolo.yaml"

  # Multiple phases (from file)
  gpu-watch --topic my-topic --name seq-run --phases phases.txt

  # phases.txt format:
  #   [rfdetr]
  #   python train/train_rfdetr.py --config config/rfdetr.yaml
  #   [rtdetr]
  #   python train/train_rtdetr.py --config config/rtdetr.yaml

  # Custom shutdown command
  gpu-watch --topic my-topic --post-cmd "shutdown -h now" -- python train.py

  # Disable auto-shutdown
  gpu-watch --topic my-topic --no-post-cmd -- python train.py
EOF
}

# ---------------------------------------------------------------------------
# Argument parsing
# ---------------------------------------------------------------------------
parse_args() {
    while [[ $# -gt 0 ]]; do
        case "$1" in
            --topic)            TOPIC="$2";              shift 2 ;;
            --name)             RUN_NAME="$2";           shift 2 ;;
            --interval)         INTERVAL="$2";           shift 2 ;;
            --metric-interval)  METRIC_INTERVAL="$2";    shift 2 ;;
            --gpu-interval)     GPU_INTERVAL="$2";       shift 2 ;;
            --log-dir)          LOG_DIR="$2";            shift 2 ;;
            --metrics-dir)      METRICS_DIR="$2";        shift 2 ;;
            --metric-keys)      METRIC_KEYS="$2";        shift 2 ;;
            --metric-top-k)     METRIC_TOP_K="$2";       shift 2 ;;
            --no-gpu)           GPU_ENABLED=false;        shift ;;
            --no-metrics)       METRICS_ENABLED=false;    shift ;;
            --post-cmd)         POST_CMD="$2";            shift 2 ;;
            --no-post-cmd)      POST_CMD_ENABLED=false;   shift ;;
            --phase)
                PHASE_NAMES+=("$2")
                PHASE_CMDS+=("$3")
                shift 3
                ;;
            --phases)           PHASES_FILE="$2";         shift 2 ;;
            --help|-h)          usage; exit 0 ;;
            --)                 shift; CMD=("$@"); break ;;
            *)
                echo "ERROR: Unknown option: $1" >&2
                usage >&2
                exit 1
                ;;
        esac
    done
}

validate_args() {
    local errors=0

    if [[ -z "$TOPIC" ]]; then
        echo "ERROR: --topic is required." >&2
        errors=1
    fi

    # Require exactly one of: -- CMD, --phase, or --phases
    local has_cmd=0 has_phases=0
    [[ ${#CMD[@]} -gt 0 ]] && has_cmd=1
    [[ ${#PHASE_CMDS[@]} -gt 0 || -n "$PHASES_FILE" ]] && has_phases=1

    if [[ $has_cmd -eq 0 && $has_phases -eq 0 ]]; then
        echo "ERROR: No command provided. Use '-- CMD', '--phase NAME CMD', or '--phases FILE'." >&2
        errors=1
    fi

    if [[ $has_cmd -eq 1 && $has_phases -eq 1 ]]; then
        echo "ERROR: Cannot mix '-- CMD' with '--phase' / '--phases'." >&2
        errors=1
    fi

    if [[ -n "$PHASES_FILE" && ! -f "$PHASES_FILE" ]]; then
        echo "ERROR: Phases file not found: $PHASES_FILE" >&2
        errors=1
    fi

    if ! [[ "$INTERVAL" =~ ^[1-9][0-9]*$ ]]; then
        echo "ERROR: --interval must be a positive integer, got: $INTERVAL" >&2
        errors=1
    fi

    if ! [[ "$METRIC_INTERVAL" =~ ^[1-9][0-9]*$ ]]; then
        echo "ERROR: --metric-interval must be a positive integer, got: $METRIC_INTERVAL" >&2
        errors=1
    fi

    if ! [[ "$GPU_INTERVAL" =~ ^[1-9][0-9]*$ ]]; then
        echo "ERROR: --gpu-interval must be a positive integer, got: $GPU_INTERVAL" >&2
        errors=1
    fi

    if ! [[ "$METRIC_TOP_K" =~ ^[1-9][0-9]*$ ]]; then
        echo "ERROR: --metric-top-k must be a positive integer, got: $METRIC_TOP_K" >&2
        errors=1
    fi

    if [[ $errors -ne 0 ]]; then
        echo "" >&2
        usage >&2
        exit 1
    fi
}

# ---------------------------------------------------------------------------
# Timestamp helpers
# ---------------------------------------------------------------------------
now_ts()    { date '+%Y-%m-%d %H:%M:%S'; }
now_file()  { date '+%Y%m%d_%H%M%S'; }
elapsed_seconds() { echo $(( $(date +%s) - START_TIME )); }

format_duration() {
    local secs=$1
    local h=$(( secs / 3600 ))
    local m=$(( (secs % 3600) / 60 ))
    local s=$(( secs % 60 ))
    printf '%02dh %02dm %02ds' "$h" "$m" "$s"
}

# ---------------------------------------------------------------------------
# ntfy notifications
# ---------------------------------------------------------------------------
send_ntfy() {
    local title="$1"
    local message="$2"
    local priority="${3:-default}"

    if ! command -v curl &>/dev/null; then
        echo "[gpu-watch] WARNING: curl not found, skipping ntfy notification." >&2
        return 0
    fi

    curl -s --max-time 10 \
        -H "Title: ${title}" \
        -H "Priority: ${priority}" \
        -d "${message}" \
        "https://ntfy.sh/${TOPIC}" \
        >/dev/null 2>&1 || {
        echo "[gpu-watch] WARNING: ntfy.sh notification failed (network issue?). Continuing." >&2
    }
}

# ---------------------------------------------------------------------------
# GPU helpers
# ---------------------------------------------------------------------------
get_gpu_summary() {
    if [[ "$GPU_ENABLED" != "true" ]]; then
        echo "GPU monitoring disabled"
        return
    fi
    if ! command -v nvidia-smi &>/dev/null; then
        echo "nvidia-smi not available"
        return
    fi
    nvidia-smi \
        --query-gpu=index,name,utilization.gpu,memory.used,memory.total,temperature.gpu,power.draw \
        --format=csv,noheader,nounits 2>/dev/null \
    | awk -F', ' '{
        printf "%s: %s | util=%s%% | mem=%s/%s MiB | temp=%sC | power=%sW\n",
               $1, $2, $3, $4, $5, $6, $7
      }' \
    || echo "GPU query failed"
}

# ---------------------------------------------------------------------------
# Metric extraction
# ---------------------------------------------------------------------------
get_metrics() {
    if [[ "$METRICS_ENABLED" != "true" ]]; then
        echo "Metrics monitoring disabled"
        return
    fi
    if ! command -v python3 &>/dev/null; then
        echo "python3 not available"
        return
    fi
    if [[ ! -f "$METRICS_SCRIPT" ]]; then
        echo "gpu_watch_metrics.py not found"
        return
    fi

    local args=(
        --dir "$METRICS_DIR"
        --top-k "$METRIC_TOP_K"
        --since "$START_TIME"
    )
    if [[ -n "$TRAIN_LOG" && -f "$TRAIN_LOG" ]]; then
        args+=(--train-log "$TRAIN_LOG")
    fi
    if [[ -n "$METRIC_KEYS" ]]; then
        args+=(--keys "$METRIC_KEYS")
    fi

    python3 "$METRICS_SCRIPT" "${args[@]}" 2>/dev/null || echo "Metrics unavailable"
}

# ---------------------------------------------------------------------------
# Multi-phase support
# ---------------------------------------------------------------------------

# Parse a phases file into PHASE_NAMES / PHASE_CMDS.
# File format:
#   # comment lines are ignored
#   [phase-name]          ← optional name header; auto-names if omitted
#   bash command string   ← one command per section
load_phases_file() {
    local file="$1"
    local pending_name=""
    local auto_num=0

    while IFS= read -r line || [[ -n "$line" ]]; do
        # Skip blank lines and comments
        [[ -z "${line//[[:space:]]/}" || "$line" =~ ^[[:space:]]*# ]] && continue
        # [name] header
        if [[ "$line" =~ ^\[([^]]+)\]$ ]]; then
            pending_name="${BASH_REMATCH[1]}"
            continue
        fi
        # Command line
        auto_num=$(( auto_num + 1 ))
        PHASE_CMDS+=("$line")
        if [[ -n "$pending_name" ]]; then
            PHASE_NAMES+=("$pending_name")
            pending_name=""
        else
            PHASE_NAMES+=("phase${auto_num}")
        fi
    done < "$file"

    if [[ ${#PHASE_CMDS[@]} -eq 0 ]]; then
        echo "ERROR: No phases found in: $file" >&2
        exit 1
    fi
}

# Run a single phase; updates globals TRAIN_LOG, FIFO, TEE_PID, CHILD_PID.
# Returns the phase exit code.
run_phase() {
    local phase_num="$1"    # 1-based
    local total="$2"
    local name="$3"
    local cmd="$4"
    local phase_log="${RUN_DIR}/train_phase${phase_num}_${name}.log"
    local combined_log="${RUN_DIR}/train.log"
    local phase_start
    phase_start=$(date +%s)

    echo ""
    echo "[gpu-watch] ── Phase ${phase_num}/${total}: ${name} ──"
    echo "[gpu-watch] Command: ${cmd}"
    echo "---"

    # Header written to both the combined log and the per-phase log
    {
        echo ""
        echo "============================================================"
        printf ' Phase %d/%d: %s\n' "$phase_num" "$total" "$name"
        echo " Command: ${cmd}"
        echo " Started: $(now_ts)"
        echo "============================================================"
        echo ""
    } | tee -a "$combined_log" >> "$phase_log"

    # Point TRAIN_LOG at this phase so status_loop / metrics see live output
    TRAIN_LOG="$phase_log"

    send_ntfy "[gpu-watch] Phase ${phase_num}/${total} started: ${name} — ${RUN_NAME}" \
        "Phase ${phase_num}/${total}: ${name}
Command: ${cmd}

Run: ${RUN_NAME}" "default"

    # FIFO approach (mirrors single-command mode; globals updated for signal handlers)
    FIFO="${RUN_DIR}/.phase${phase_num}_fifo"
    mkfifo "$FIFO"

    tee -a "$combined_log" -a "$phase_log" < "$FIFO" &
    TEE_PID=$!

    set +e
    bash -c "$cmd" > "$FIFO" 2>&1 &
    CHILD_PID=$!
    wait "$CHILD_PID"
    local phase_exit=$?
    set -e

    CHILD_PID=""
    rm -f "$FIFO"
    FIFO=""
    wait "$TEE_PID" 2>/dev/null || true
    TEE_PID=""

    local phase_elapsed=$(( $(date +%s) - phase_start ))
    local phase_elapsed_fmt
    phase_elapsed_fmt="$(format_duration "$phase_elapsed")"

    # Footer
    {
        echo ""
        echo "============================================================"
        printf ' Phase %d/%d: %s — EXIT %d — %s\n' \
            "$phase_num" "$total" "$name" "$phase_exit" "$phase_elapsed_fmt"
        echo "============================================================"
    } | tee -a "$combined_log" >> "$phase_log"

    if [[ "$phase_exit" -eq 0 ]]; then
        echo "[gpu-watch] Phase ${phase_num}/${total} (${name}) succeeded in ${phase_elapsed_fmt}."
        local phase_metrics
        phase_metrics="$(get_metrics)"
        send_ntfy "[gpu-watch] Phase ${phase_num}/${total} done: ${name} — ${RUN_NAME}" \
            "Phase ${phase_num}/${total}: ${name} SUCCESS
Duration: ${phase_elapsed_fmt}

Metrics:
${phase_metrics}

Run: ${RUN_NAME}" "default"
    else
        echo "[gpu-watch] Phase ${phase_num}/${total} (${name}) FAILED (exit ${phase_exit}) after ${phase_elapsed_fmt}."
        local phase_tail
        phase_tail="$(tail -n 20 "$phase_log" 2>/dev/null || true)"
        send_ntfy "[gpu-watch] Phase ${phase_num}/${total} FAILED: ${name} — ${RUN_NAME}" \
            "Phase ${phase_num}/${total}: ${name} FAILED (exit ${phase_exit})
Duration: ${phase_elapsed_fmt}

Last output:
${phase_tail}

Run: ${RUN_NAME}" "high"
    fi

    return "$phase_exit"
}

# Run all phases sequentially; stops at the first failure.
run_all_phases() {
    local total=${#PHASE_CMDS[@]}
    local overall_exit=0

    echo "[gpu-watch] Running ${total} phase(s) sequentially: ${PHASE_NAMES[*]}"

    for (( i=0; i<total; i++ )); do
        if ! run_phase "$(( i+1 ))" "$total" "${PHASE_NAMES[$i]}" "${PHASE_CMDS[$i]}"; then
            overall_exit=$?
            echo "[gpu-watch] Stopping: phase $(( i+1 ))/${total} (${PHASE_NAMES[$i]}) failed."
            break
        fi
    done

    return "$overall_exit"
}

# ---------------------------------------------------------------------------
# Post-training command
# ---------------------------------------------------------------------------
run_post_cmd() {
    local exit_code="$1"

    if [[ "$POST_CMD_ENABLED" != "true" ]]; then
        return
    fi

    echo ""
    echo "[gpu-watch] Post-command: ${POST_CMD}"

    if [[ "$exit_code" -eq 0 ]]; then
        echo "[gpu-watch] Training succeeded — running post-command now."
        send_ntfy "[gpu-watch] Running post-command: ${RUN_NAME}" \
            "Training succeeded. Running: ${POST_CMD}" "default"
        bash -c "$POST_CMD"
        return
    fi

    # Training failed — give the user a 30-minute window to interact
    echo "[gpu-watch] Training FAILED (exit ${exit_code})."
    echo "[gpu-watch] Post-command will run automatically in 30 minutes."
    echo "[gpu-watch]   → Type 'run' + Enter    to run it NOW"
    echo "[gpu-watch]   → Type 'cancel' + Enter to SKIP it"
    echo ""

    send_ntfy "[gpu-watch] Waiting before post-command: ${RUN_NAME}" \
        "Training failed (exit ${exit_code}). Post-command will run in 30 min:
${POST_CMD}

Reply in your terminal: 'run' = run now, 'cancel' = skip." "high"

    local remaining=$POST_CMD_DELAY
    local user_input

    # If stdin is not a terminal (e.g. piped / nohup), skip the interactive wait
    if [[ ! -t 0 ]]; then
        echo "[gpu-watch] stdin is not a terminal — waiting ${POST_CMD_DELAY}s silently."
        sleep "$POST_CMD_DELAY"
        echo "[gpu-watch] Timeout reached. Running post-command."
        send_ntfy "[gpu-watch] Running post-command: ${RUN_NAME}" \
            "30-min window elapsed. Running: ${POST_CMD}" "high"
        bash -c "$POST_CMD"
        return
    fi

    while (( remaining > 0 )); do
        local mins=$(( remaining / 60 ))
        local secs=$(( remaining % 60 ))

        # Print a countdown line at meaningful intervals
        if (( remaining == POST_CMD_DELAY ))      || \
           (( remaining % 300 == 0 ))             || \
           (( remaining <= 60 && remaining % 10 == 0 )); then
            printf "[gpu-watch] Post-command in %02dm %02ds  ('run'=run now, 'cancel'=skip)\n" \
                "$mins" "$secs"
        fi

        # Poll stdin with a 1-second timeout
        if read -t 1 -r user_input 2>/dev/null; then
            echo ""
            case "${user_input,,}" in
                cancel|skip|no|n)
                    echo "[gpu-watch] Post-command cancelled by user."
                    send_ntfy "[gpu-watch] Post-command skipped: ${RUN_NAME}" \
                        "User cancelled the post-command." "default"
                    return
                    ;;
                run|yes|y)
                    echo "[gpu-watch] Running post-command now (user request)."
                    send_ntfy "[gpu-watch] Running post-command: ${RUN_NAME}" \
                        "User triggered early run: ${POST_CMD}" "high"
                    bash -c "$POST_CMD"
                    return
                    ;;
                *)
                    printf "[gpu-watch] Unknown input '%s'. Type 'run' to run now or 'cancel' to skip.\n" \
                        "$user_input"
                    ;;
            esac
        fi

        remaining=$(( remaining - 1 ))
    done

    echo ""
    echo "[gpu-watch] 30-minute window elapsed. Running post-command."
    send_ntfy "[gpu-watch] Running post-command: ${RUN_NAME}" \
        "30-min window elapsed. Running: ${POST_CMD}" "high"
    bash -c "$POST_CMD"
}

# ---------------------------------------------------------------------------
# GPU logging loop (background)
# ---------------------------------------------------------------------------
gpu_loop() {
    while true; do
        sleep "$GPU_INTERVAL"
        [[ -f "${RUN_DIR}/.running" ]] || break
        {
            echo "--- $(now_ts) ---"
            get_gpu_summary
            echo ""
        } >> "$GPU_LOG" 2>&1
    done
}

# ---------------------------------------------------------------------------
# Status / ntfy loop (background)
# ---------------------------------------------------------------------------
status_loop() {
    local next_ntfy=$(( INTERVAL * 60 ))
    local next_metric=$(( METRIC_INTERVAL * 60 ))
    local elapsed
    local tick=30  # resolution: every 30 s

    # Always tail the combined log — works for both single-command and multi-phase
    # modes (TRAIN_LOG changes per-phase in the parent but isn't visible here).
    local combined_log="${RUN_DIR}/train.log"

    # Track stage transitions so we can fire immediate ntfy on each stage change.
    # Patterns emitted by the training scripts (all three models use the same format):
    #   start  → "Stage N/total: stage_name"
    #   finish → "Finished stage N: stage_name (Xs)"
    #          → "Interrupted stage N: stage_name (Xs)"
    local last_stage_start=""
    local last_stage_finish=""

    while true; do
        sleep "$tick"
        [[ -f "${RUN_DIR}/.running" ]] || break

        elapsed=$(elapsed_seconds)

        # ── Training-stage transition detection ───────────────────────────────
        if [[ -f "$combined_log" ]]; then
            # ── Stage started ─────────────────────────────────────────────────
            local cur_stage
            cur_stage="$(grep -E '^Stage [0-9]+/[0-9]+:' "$combined_log" 2>/dev/null \
                | tail -1 || true)"

            if [[ -n "$cur_stage" && "$cur_stage" != "$last_stage_start" ]]; then
                last_stage_start="$cur_stage"
                local stage_detail gpu_snap elapsed_fmt phase_ctx

                # Grab the config lines that follow the header (freeze, epochs, lr0, …)
                # Skip the header itself (tail -n +2) and the surrounding === lines.
                stage_detail="$(grep -A 6 -F "$cur_stage" "$combined_log" 2>/dev/null \
                    | tail -n +2 \
                    | grep -vE '^[[:space:]]*=+[[:space:]]*$' \
                    | grep -v '^[[:space:]]*$' \
                    | head -5 || true)"

                gpu_snap="$(get_gpu_summary)"
                elapsed_fmt="$(format_duration "$elapsed")"

                # In multi-phase runs include the enclosing phase name for context
                phase_ctx="$(grep -E '^ Phase [0-9]+/[0-9]+:' "$combined_log" 2>/dev/null \
                    | tail -1 | sed 's/^[[:space:]]*//' || true)"
                [[ -n "$phase_ctx" ]] && phase_ctx="${phase_ctx} → "

                send_ntfy "[gpu-watch] Stage started — ${RUN_NAME}" \
"${phase_ctx}${cur_stage}
${stage_detail}
GPU:
${gpu_snap}
Elapsed: ${elapsed_fmt} | Run: ${RUN_NAME}" "default"
            fi

            # ── Stage finished ────────────────────────────────────────────────
            local cur_finish
            cur_finish="$(grep -E '^(Finished|Interrupted) stage [0-9]+:' \
                "$combined_log" 2>/dev/null | tail -1 || true)"

            if [[ -n "$cur_finish" && "$cur_finish" != "$last_stage_finish" ]]; then
                last_stage_finish="$cur_finish"
                local stage_metrics gpu_snap elapsed_fmt

                stage_metrics="$(get_metrics)"
                gpu_snap="$(get_gpu_summary)"
                elapsed_fmt="$(format_duration "$elapsed")"

                send_ntfy "[gpu-watch] Stage done — ${RUN_NAME}" \
"${cur_finish}

Metrics:
${stage_metrics}

GPU:
${gpu_snap}
Elapsed: ${elapsed_fmt} | Run: ${RUN_NAME}" "default"
            fi
        fi

        # ── Metric snapshot ───────────────────────────────────────────────────
        if (( elapsed >= next_metric )); then
            {
                echo "--- $(now_ts) ---"
                get_metrics
                echo ""
            } >> "$METRICS_LOG" 2>&1
            next_metric=$(( elapsed + METRIC_INTERVAL * 60 ))
        fi

        # ── Periodic ntfy ─────────────────────────────────────────────────────
        if (( elapsed >= next_ntfy )); then
            local gpu_info elapsed_fmt latest_metrics tail_lines msg stage_line
            gpu_info="$(get_gpu_summary)"
            elapsed_fmt="$(format_duration "$elapsed")"
            latest_metrics="$(get_metrics)"
            tail_lines="$(tail -n 10 "$combined_log" 2>/dev/null || true)"

            # Include current stage if one has been detected
            stage_line=""
            [[ -n "$last_stage_start" ]] && stage_line="
Stage: ${last_stage_start}"

            msg="Run: ${RUN_NAME}
Elapsed: ${elapsed_fmt}${stage_line}

GPU:
${gpu_info}

Metrics:
${latest_metrics}

Recent output:
${tail_lines}"
            send_ntfy "[gpu-watch] ${RUN_NAME} still running" "$msg" "default"
            next_ntfy=$(( elapsed + INTERVAL * 60 ))
        fi
    done
}

# ---------------------------------------------------------------------------
# Stop background loops
# ---------------------------------------------------------------------------
stop_loops() {
    rm -f "${RUN_DIR}/.running" 2>/dev/null || true
    if [[ -n "$GPU_LOOP_PID" ]]; then
        kill "$GPU_LOOP_PID"    2>/dev/null || true
        wait "$GPU_LOOP_PID"    2>/dev/null || true
        GPU_LOOP_PID=""
    fi
    if [[ -n "$STATUS_LOOP_PID" ]]; then
        kill "$STATUS_LOOP_PID" 2>/dev/null || true
        wait "$STATUS_LOOP_PID" 2>/dev/null || true
        STATUS_LOOP_PID=""
    fi
}

# ---------------------------------------------------------------------------
# Cleanup / signal handlers
# ---------------------------------------------------------------------------
cleanup() {
    local exit_code="${1:-0}"
    local reason="${2:-}"

    stop_loops

    # Save end-of-run artifacts (best effort)
    local end_ts elapsed_secs elapsed_fmt
    end_ts="$(now_ts)"
    elapsed_secs=$(elapsed_seconds)
    elapsed_fmt="$(format_duration "$elapsed_secs")"

    command -v nvidia-smi &>/dev/null && \
        nvidia-smi > "${RUN_DIR}/nvidia_smi_end.txt" 2>&1 || true
    df -h  > "${RUN_DIR}/disk_end.txt"   2>/dev/null || true
    command -v free &>/dev/null && \
        free -h > "${RUN_DIR}/memory_end.txt" 2>/dev/null || true

    echo "$exit_code" > "${RUN_DIR}/exit_code.txt"

    local start_readable
    start_readable="$(date -d "@${START_TIME}" '+%Y-%m-%d %H:%M:%S' 2>/dev/null \
        || date -r "$START_TIME" '+%Y-%m-%d %H:%M:%S' 2>/dev/null \
        || echo "N/A")"

    local cmd_summary
    if [[ ${#PHASE_CMDS[@]} -gt 0 ]]; then
        local phase_lines=""
        for (( _i=0; _i<${#PHASE_CMDS[@]}; _i++ )); do
            phase_lines+="                   $(( _i+1 )). ${PHASE_NAMES[$_i]}: ${PHASE_CMDS[$_i]}"$'\n'
        done
        cmd_summary="(${#PHASE_CMDS[@]} phases)"$'\n'"${phase_lines}"
    else
        cmd_summary="${CMD[*]}"
    fi

    cat > "${RUN_DIR}/summary.txt" <<EOF
Run Name:          ${RUN_NAME}
Start Time:        ${start_readable}
End Time:          ${end_ts}
Duration:          ${elapsed_fmt}
Exit Code:         ${exit_code}
Command:           ${cmd_summary}
Hostname:          $(hostname 2>/dev/null || echo "unknown")
Working Directory: $(pwd)
GPU Enabled:       ${GPU_ENABLED}
Metrics Enabled:   ${METRICS_ENABLED}
Log Directory:     ${RUN_DIR}
EOF

    if [[ "$FINAL_SENT" -eq 0 ]]; then
        FINAL_SENT=1
        local final_metrics final_gpu tail_lines msg

        final_metrics="$(get_metrics)"
        final_gpu="$(get_gpu_summary)"

        if [[ -n "$reason" ]]; then
            tail_lines="$(tail -n 20 "$TRAIN_LOG" 2>/dev/null || true)"
            msg="Run: ${RUN_NAME}
Elapsed: ${elapsed_fmt}
Reason: ${reason}

GPU:
${final_gpu}

Metrics:
${final_metrics}

Last output:
${tail_lines}"
            send_ntfy "[gpu-watch] INTERRUPTED: ${RUN_NAME}" "$msg" "high"

        elif [[ "$exit_code" -eq 0 ]]; then
            tail_lines="$(tail -n 10 "$TRAIN_LOG" 2>/dev/null || true)"
            msg="Run: ${RUN_NAME}
Duration: ${elapsed_fmt}
Exit code: ${exit_code}

GPU:
${final_gpu}

Final metrics:
${final_metrics}

Last output:
${tail_lines}"
            send_ntfy "[gpu-watch] SUCCESS: ${RUN_NAME}" "$msg" "high"

        else
            tail_lines="$(tail -n 40 "$TRAIN_LOG" 2>/dev/null || true)"
            msg="Run: ${RUN_NAME}
Duration: ${elapsed_fmt}
Exit code: ${exit_code}

GPU:
${final_gpu}

Final metrics:
${final_metrics}

Last output:
${tail_lines}"
            send_ntfy "[gpu-watch] FAILED (exit ${exit_code}): ${RUN_NAME}" "$msg" "urgent"
        fi
    fi

    # Cleanup FIFO
    [[ -n "$FIFO" && -p "$FIFO" ]] && rm -f "$FIFO" 2>/dev/null || true

    echo "[gpu-watch] Run complete. Duration: ${elapsed_fmt} | Exit: ${exit_code} | Logs: ${RUN_DIR}"
}

handle_sigint() {
    echo "" >&2
    echo "[gpu-watch] Caught SIGINT — shutting down." >&2
    [[ -n "$CHILD_PID" ]] && kill -INT  "$CHILD_PID" 2>/dev/null || true
    [[ -n "$TEE_PID"   ]] && kill       "$TEE_PID"   2>/dev/null || true
    POST_CMD_ENABLED=false   # don't run post-command on user interrupt
    FINAL_SENT=1
    local elapsed_fmt tail_lines msg
    elapsed_fmt="$(format_duration "$(elapsed_seconds)")"
    tail_lines="$(tail -n 20 "${RUN_DIR}/train.log" 2>/dev/null || true)"
    msg="Run: ${RUN_NAME}
Elapsed: ${elapsed_fmt}
Reason: SIGINT (user interrupt)

Last output:
${tail_lines}"
    send_ntfy "[gpu-watch] INTERRUPTED: ${RUN_NAME}" "$msg" "high"
    cleanup 130
    exit 130
}

handle_sigterm() {
    echo "" >&2
    echo "[gpu-watch] Caught SIGTERM — Kubernetes shutdown?" >&2
    [[ -n "$CHILD_PID" ]] && kill -TERM "$CHILD_PID" 2>/dev/null || true
    [[ -n "$TEE_PID"   ]] && kill       "$TEE_PID"   2>/dev/null || true
    POST_CMD_ENABLED=false   # pod is already being killed; skip post-command
    FINAL_SENT=1
    local elapsed_fmt tail_lines msg
    elapsed_fmt="$(format_duration "$(elapsed_seconds)")"
    tail_lines="$(tail -n 20 "${RUN_DIR}/train.log" 2>/dev/null || true)"
    msg="Run: ${RUN_NAME}
Elapsed: ${elapsed_fmt}
Reason: SIGTERM (pod termination / Kubernetes eviction)

Last output:
${tail_lines}"
    send_ntfy "[gpu-watch] TERMINATED: ${RUN_NAME}" "$msg" "urgent"
    cleanup 143
    exit 143
}

# ---------------------------------------------------------------------------
# Main
# ---------------------------------------------------------------------------
main() {
    parse_args "$@"

    # Load phases file before validate_args so PHASE_CMDS is populated for checks
    if [[ -n "$PHASES_FILE" ]]; then
        load_phases_file "$PHASES_FILE"
    fi

    validate_args

    if [[ -z "$RUN_NAME" ]]; then
        RUN_NAME="run-$(date '+%Y%m%d-%H%M%S')"
    fi

    RUN_DIR="${LOG_DIR}/${RUN_NAME}_$(now_file)"
    if ! mkdir -p "$RUN_DIR"; then
        echo "ERROR: Cannot create log directory: ${RUN_DIR}" >&2
        exit 1
    fi

    TRAIN_LOG="${RUN_DIR}/train.log"
    GPU_LOG="${RUN_DIR}/gpu.log"
    METRICS_LOG="${RUN_DIR}/metrics.log"

    START_TIME=$(date +%s)
    touch "${RUN_DIR}/.running"

    # Auto-disable GPU if nvidia-smi missing
    if [[ "$GPU_ENABLED" == "true" ]] && ! command -v nvidia-smi &>/dev/null; then
        echo "[gpu-watch] WARNING: nvidia-smi not found. Disabling GPU monitoring." >&2
        GPU_ENABLED=false
    fi

    # Auto-disable metrics if python3 or script missing
    if [[ "$METRICS_ENABLED" == "true" ]]; then
        if ! command -v python3 &>/dev/null; then
            echo "[gpu-watch] WARNING: python3 not found. Disabling metric monitoring." >&2
            METRICS_ENABLED=false
        elif [[ ! -f "$METRICS_SCRIPT" ]]; then
            echo "[gpu-watch] WARNING: gpu_watch_metrics.py not found. Disabling metric monitoring." >&2
            METRICS_ENABLED=false
        fi
    fi

    # Save environment info
    {
        echo "Hostname:     $(hostname 2>/dev/null || echo unknown)"
        echo "User:         $(id -un 2>/dev/null || echo unknown)"
        echo "Working Dir:  $(pwd)"
        echo "Shell:        ${SHELL:-unknown}"
        echo "PATH:         ${PATH:-unknown}"
        echo ""
        echo "Python:       $(python3 --version 2>&1 || echo 'not available')"
        echo "pip:          $(python3 -m pip --version 2>&1 || echo 'not available')"
        echo ""
        for var in CUDA_VISIBLE_DEVICES NVIDIA_VISIBLE_DEVICES NVIDIA_DRIVER_CAPABILITIES \
                   POD_NAME POD_NAMESPACE NODE_NAME; do
            echo "${var}:   ${!var:-not set}"
        done
    } > "${RUN_DIR}/environment.txt"

    if [[ ${#PHASE_CMDS[@]} -gt 0 ]]; then
        for (( _i=0; _i<${#PHASE_CMDS[@]}; _i++ )); do
            echo "Phase $(( _i+1 )) (${PHASE_NAMES[$_i]}): ${PHASE_CMDS[$_i]}"
        done > "${RUN_DIR}/command.txt"
    else
        echo "${CMD[*]}" > "${RUN_DIR}/command.txt"
    fi

    command -v nvidia-smi &>/dev/null && \
        nvidia-smi > "${RUN_DIR}/nvidia_smi_start.txt" 2>&1 || true
    df -h  > "${RUN_DIR}/disk_start.txt"   2>/dev/null || true
    command -v free &>/dev/null && \
        free -h > "${RUN_DIR}/memory_start.txt" 2>/dev/null || true

    # pip freeze — run in background so it doesn't block startup
    (python3 -m pip freeze > "${RUN_DIR}/pip_freeze.txt" 2>/dev/null || true) &

    # Install signal handlers before starting anything
    trap handle_sigint  SIGINT
    trap handle_sigterm SIGTERM

    # Start notification
    local gpu_start_info start_msg
    gpu_start_info="$(get_gpu_summary)"

    if [[ ${#PHASE_CMDS[@]} -gt 0 ]]; then
        local phase_list=""
        for (( _i=0; _i<${#PHASE_CMDS[@]}; _i++ )); do
            phase_list+="$(( _i+1 )). ${PHASE_NAMES[$_i]}: ${PHASE_CMDS[$_i]}"$'\n'
        done
        start_msg="Run: ${RUN_NAME}
Phases (${#PHASE_CMDS[@]}):
${phase_list}
Host: $(hostname 2>/dev/null || echo unknown)${POD_NAME:+ / pod=$POD_NAME}
Dir: $(pwd)
Logs: ${RUN_DIR}

GPU:
${gpu_start_info}"
    else
        start_msg="Run: ${RUN_NAME}
Command: ${CMD[*]}
Host: $(hostname 2>/dev/null || echo unknown)${POD_NAME:+ / pod=$POD_NAME}
Dir: $(pwd)
Logs: ${RUN_DIR}

GPU:
${gpu_start_info}"
    fi
    send_ntfy "[gpu-watch] STARTED: ${RUN_NAME}" "$start_msg" "default"

    echo "[gpu-watch] Starting run: ${RUN_NAME}"
    echo "[gpu-watch] Logs: ${RUN_DIR}"
    if [[ ${#PHASE_CMDS[@]} -gt 0 ]]; then
        echo "[gpu-watch] Phases (${#PHASE_CMDS[@]}): ${PHASE_NAMES[*]}"
    else
        echo "[gpu-watch] Command: ${CMD[*]}"
    fi
    echo "[gpu-watch] GPU enabled: ${GPU_ENABLED} | Metrics enabled: ${METRICS_ENABLED}"
    echo "[gpu-watch] ntfy topic: ${TOPIC}"
    echo "---"

    # Start background loops
    if [[ "$GPU_ENABLED" == "true" ]]; then
        gpu_loop &
        GPU_LOOP_PID=$!
    fi

    status_loop &
    STATUS_LOOP_PID=$!

    if [[ ${#PHASE_CMDS[@]} -gt 0 ]]; then
        # -----------------------------------------------------------------
        # Multi-phase mode
        # Each phase manages its own FIFO/tee and updates TRAIN_LOG.
        # -----------------------------------------------------------------
        set +e
        run_all_phases
        EXIT_CODE=$?
        set -e

        # Point TRAIN_LOG at the combined log for the final cleanup summary
        TRAIN_LOG="${RUN_DIR}/train.log"
    else
        # -----------------------------------------------------------------
        # Single-command mode
        #
        # Use a named FIFO so we can:
        #   1. Track the real child PID (needed to forward SIGTERM in Kubernetes)
        #   2. Capture the exact exit code with PIPESTATUS-free accounting
        #   3. Stream output live to terminal AND log via tee
        # -----------------------------------------------------------------
        FIFO="${RUN_DIR}/.train_fifo"
        mkfifo "$FIFO"

        # tee reads from the FIFO — writes to terminal and log simultaneously
        tee -a "$TRAIN_LOG" < "$FIFO" &
        TEE_PID=$!

        set +e
        "${CMD[@]}" > "$FIFO" 2>&1 &
        CHILD_PID=$!
        wait "$CHILD_PID"
        EXIT_CODE=$?
        set -e

        CHILD_PID=""

        # Close FIFO write end so tee sees EOF and exits
        rm -f "$FIFO"
        FIFO=""
        wait "$TEE_PID" 2>/dev/null || true
        TEE_PID=""
    fi

    stop_loops

    # Final metric snapshot
    {
        echo "--- $(now_ts) [final] ---"
        get_metrics
        echo ""
    } >> "$METRICS_LOG" 2>&1

    cleanup "$EXIT_CODE"
    run_post_cmd "$EXIT_CODE"
    exit "$EXIT_CODE"
}

main "$@"
